# Canonical site URL — used for SEO metadata, robots.txt, and sitemap.xml.
# Set this to your production domain. On Vercel it also falls back automatically
# to VERCEL_PROJECT_PRODUCTION_URL, so this is optional there.
SITE_URL=https://your-domain.com

# Contact form email provider (optional — see README "Contact form").
# Sign up at https://resend.com and paste your key here, then wire up a route handler.
RESEND_API_KEY=
