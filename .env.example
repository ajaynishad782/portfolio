# Canonical site URL — used for SEO metadata, robots.txt, and sitemap.xml.
# Set this to your production domain. On Vercel it also falls back automatically
# to VERCEL_PROJECT_PRODUCTION_URL, so this is optional there.
SITE_URL=https://your-domain.com

# Contact form email delivery via Resend (see README "Contact form").
# Sign up at https://resend.com, create an API key, and paste it here. Without
# it the /api/contact route returns a 500 and the form shows an error.
RESEND_API_KEY=

# Optional. Verified sender address shown in the "From" field. Requires you to
# verify a domain in Resend. Defaults to Resend's shared sandbox sender
# (onboarding@resend.dev), which only delivers to your own account's address.
CONTACT_FROM=Portfolio <onboarding@resend.dev>

# Optional. Inbox that receives submissions. Defaults to personal.email in
# src/data/portfolio.ts.
CONTACT_TO=
